# -----------------------------------------------------------------------------
# Gmail SMTP — RSVP Email Configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
#
# How to create a Gmail App Password (REQUIRED — your regular password will
# NOT work if 2-Step Verification is enabled on your Google account):
#
#   1. Go to https://myaccount.google.com/security
#   2. Make sure "2-Step Verification" is turned ON
#   3. Under "Signing in to Google", click "App passwords"
#   4. App → "Other (Custom name)" → e.g. "Wedding RSVP"
#   5. Copy the 16-character password it generates and paste it below.
#
# If 2-Step Verification is OFF (not recommended), you may still need to
# enable "Less secure app access"; Google has deprecated this, so the
# App Password route above is the only reliable path.
# -----------------------------------------------------------------------------

# Your full Gmail address that will SEND the RSVP emails
GMAIL_USER=your.address@gmail.com

# The 16-character Gmail App Password (NOT your regular Gmail password)
GMAIL_APP_PASSWORD=abcdabcdabcdabcd

# -----------------------------------------------------------------------------
# (Optional) Where RSVP emails are DELIVERED.
# Leave blank or remove to send to the same address as GMAIL_USER above.
# -----------------------------------------------------------------------------
RSVP_RECIPIENT_EMAIL=
